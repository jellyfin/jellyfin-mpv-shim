; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "JellyHome Player"
#define MyAppVersion "3.3.0"
; Publisher is unknown until the fork has a code-signing identity; the upstream
; author is credited in LICENSE.md and the README, not claimed here.
#define MyAppPublisher "JellyHome Player contributors"
#define MyAppURL "https://github.com/braisravina/jellyhome-player"
#define MyAppExeName "JellyHomePlayer.exe"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
; A GUID of this fork's own. It MUST differ from upstream's, or the two
; installers would treat each other as an upgrade/uninstall of themselves.
AppId={{7E3C5B3A-52D1-4C0E-9B1D-2A6F4D8E91C7}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
; Defined by build-win-arm64.bat via ISCC /DArm64. The payload is then a
; native ARM64 build, so it must not be offered to an x64 machine -- and
; without the second directive Inno runs in 32-bit mode even on ARM64, which
; puts a 64-bit application under "Program Files (x86)" and points its
; registry writes at the WOW64 view.
;
; The installer executable itself stays 32-bit x86 whatever this says, since
; that is the only thing ISCC emits; Windows on ARM emulates it to run the
; install. Only the payload and the install locations are architecture-bound.
#ifdef Arm64
ArchitecturesAllowed=arm64
ArchitecturesInstallIn64BitMode=arm64
#endif
DisableProgramGroupPage=yes
LicenseFile=LICENSE.md
; Per-user install by default: no administrator rights, installs under
; %LOCALAPPDATA%\Programs. The user can still choose "all users" in the dialog.
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
OutputDir=dist
OutputBaseFilename=jellyhome-player_version_installer
SetupIconFile=jellyfin.ico
Compression=lzma
SolidCompression=yes
WizardStyle=modern
; Ask (not force) and only for programs holding files of THIS install.
CloseApplications=yes
CloseApplicationsFilter={#MyAppExeName},mpv-2.dll
RestartApplications=no

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "dist\JellyHomePlayer\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Registry]
; "Start with computer" is the app's own opt-in (Settings). It writes this
; value; the uninstaller removes it so no dangling startup entry is left.
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueName: "{#MyAppName}"; Flags: dontcreatekey uninsdeletevalue

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

