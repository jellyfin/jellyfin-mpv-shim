#. Checkbox in the filter panel's Features section. Restricts the library
#. to items that have a trailer.
#: jellyfin_mpv_shim/mpvtk_browser/dialogs.py
msgid "Has Trailer"
msgstr "Té tràiler"

#. Checkbox in the filter panel's Features section. Restricts the library
#. to items with bonus material (deleted scenes, featurettes).
