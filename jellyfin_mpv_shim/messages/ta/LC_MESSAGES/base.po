# seeded from jellyfin-web: ButtonSignIn
#. Button, and the title of the screen it opens. Signs back in to a server
#. that is already saved, because the stored login stopped working -- not
#. adding a new one. "Again" is the load-bearing word.
#: jellyfin_mpv_shim/mpvtk_browser/auth.py
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
msgid "Sign In Again"
msgstr "மீண்டும் உள்நுழையவும்"

