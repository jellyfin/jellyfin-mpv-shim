#. Shown on the Logs tab when nothing has been logged.
#: jellyfin_mpv_shim/mpvtk_browser/settings/logs.py
msgid "No log output captured yet."
msgstr "இதுவரை எந்தப் பதிவு வெளியீடும் பெறப்படவில்லை."

#. Status message when Copy was pressed on an empty log.
#: jellyfin_mpv_shim/mpvtk_browser/settings/logs.py
msgid "There is nothing to copy yet."
msgstr "இன்னும் நகலெடுப்பதற்கு எதுவும் இல்லை."

#. Status message confirming the log reached the clipboard. %d is how many
#. lines.
#: jellyfin_mpv_shim/mpvtk_browser/settings/logs.py
#, python-format
msgid "Copied %d log lines."
msgstr "%d பதிவு வரிகள் நகலெடுக்கப்பட்டன."

#. State beside a server in Settings: the application can reach it.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
msgid "Connected"
msgstr "இணைக்கப்பட்டது"

#. One-word status in the Servers list: this server answered, but it no
#. longer accepts the saved login, so the user has to sign in again. The
#. other two states are "Connected" and "Offline".
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
msgid "Signed out"
msgstr "வெளியேறியது"

#. State beside a server in Settings: the application cannot reach it.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
msgid "Offline"
msgstr "ஆஃப்லைன்"

#. Placeholder in the empty field where the name of a new local profile is
#. typed, in the Users settings. These are this application's own profiles,
#. each with its own servers, not Jellyfin accounts.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
msgid "New user name…"
msgstr "புதிய பயனர்பெயர்…"

#. Button in the Users settings that creates a new local profile. An
#. imperative verb phrase.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
msgid "Add User"
msgstr "பயனரைச் சேர்க்கவும்"

#. Shown in the Servers settings when this profile has signed in to
#. nothing.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
msgid "No servers configured yet."
msgstr "இன்னும் சேவையகங்கள் எதுவும் உள்ளமைக்கப்படவில்லை."

#. Heading of the Users section of Settings, listing this application's
#. local profiles.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
msgid "Users"
msgstr "பயனர்கள்"

#. Subtitle under the Users heading in Settings. These are this
#. application's own local profiles, not Jellyfin accounts, and a locked
#. one asks for its numeric passcode before it will open.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
msgid ""
"Each user has its own servers and device identity; a locked user needs a PIN "
"to switch to."
msgstr ""
"ஒவ்வொரு பயனருக்கும் அதற்கெனத் தனிப்பட்ட சேவையகங்களும் சாதன அடையாளமும் உண்டு; பூட்டப்பட்ட "
"பயனர் அடுத்த நிலைக்கு மாற ஒரு PIN தேவைப்படும்."

#. Heading of the Servers section of Settings. %s is the name of the local
#. profile whose servers are listed.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
#, python-format
msgid "Servers for %s"
msgstr "%s க்கான சேவையகங்கள்"

#. Heading of the Servers section of Settings, used when no profile is
#. named.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
msgid "Servers"
msgstr "சர்வர்கள்"

#. Button beside a local profile in Settings that alters its numeric
#. passcode. An imperative verb phrase.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
msgid "Change PIN"
msgstr "PIN-ஐ மாற்றவும்"

#. Button beside a local profile in Settings that gives it a numeric
#. passcode. An imperative verb phrase.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
msgid "Set PIN"
msgstr "PIN-ஐ அமைக்கவும்"

#. Question in the dialog that removes a local profile. %s is the profile's
#. name; "saved logins" are the servers it is signed in to.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
#, python-format
msgid "Delete user %s and its saved logins?"
msgstr "பயனர் %s மற்றும் அவரது சேமிக்கப்பட்ட உள்நுழைவுகளை நீக்கவா?"

# seeded from jellyfin-web: DeleteUser
#. Title of the dialog that removes a local profile.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
msgid "Delete User"
msgstr "பயனரை நீக்கு"

#. Marker beside the local profile currently in use, in the Users settings.
#. Lower case, a small caption rather than a sentence.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
msgid "active"
msgstr "செயலில்"

#. Question in the dialog that forgets a server. %s is the server's name.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
#, python-format
msgid "Remove %s and its saved login?"
msgstr "%s மற்றும் அதன் சேமிக்கப்பட்ட உள்நுழைவை நீக்கவா?"

#. Title of the dialog that forgets a server.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
msgid "Remove Server"
msgstr "சேவையகத்தை அகற்று"

#. Checkbox beside a server in Settings, letting that server's new episodes
#. be fetched automatically.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
msgid "Auto-download"
msgstr "தானாக பதிவிறக்கம்"

#. Status message when a reconnect to a server is already under way: the user
#. pressed Retry a second time, or something else (the periodic health check)
#. was already connecting to it.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
msgid "Already reconnecting."
msgstr "ஏற்கனவே மீண்டும் இணைகிறது."

# seeded from jellyfin-web: Connect
#. Status message after a manual retry succeeded. %s is the server's name.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
#, python-format
msgid "Connected to %s."
msgstr "%s உடன் இணைக்கப்பட்டுள்ளது."

#. Status message while a manual retry is running. %s is the server's name.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
#, python-format
msgid "Connecting to %s…"
msgstr "%s உடன் இணைக்கிறது…"

#. Body of the dialog shown when a server could not be reached. %s is the
#. server's name. This is the version for a server that IS reachable and
#. refused the login.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
#, python-format
msgid ""
"%s answered, but it no longer accepts the saved login. Signing in again "
"keeps its downloads and settings."
msgstr ""
"%s பதிலளித்தது, ஆனால் அது சேமிக்கப்பட்ட உள்நுழைவை இனி ஏற்கவில்லை. மீண்டும் உள்நுழையும்போது "
"அதன் பதிவிறக்கங்களும் அமைப்புகளும் அப்படியே இருக்கின்றன."

#. Body of the same dialog, for a server that did not respond at all. %s is
#. the server's name.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
#, python-format
msgid ""
"%s did not answer. It may be switched off, or this machine may not be able "
"to reach it right now."
msgstr ""
"%s பதிலளிக்கவில்லை. அது அணைக்கப்பட்டிருக்கலாம், அல்லது இந்த இயந்திரத்தால் தற்சமயம் அதை அணுக "
"முடியாமல் இருக்கலாம்."

#. Title of that dialog. %s is the server's name.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
#, python-format
msgid "Couldn't connect to %s"
msgstr "%s உடன் இணைக்க முடியவில்லை"

#. Status message when forgetting a server failed.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
msgid "The server could not be removed."
msgstr "சேவையகத்தை அகற்ற முடியவில்லை."

#. Status message when creating a local profile failed.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
msgid "That user could not be added."
msgstr "அந்தப் பயனரைச் சேர்க்க முடியவில்லை."

#. Title of the dialog that changes a local profile's name.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
msgid "Rename User"
msgstr "பயனரை மறுபெயரிடு"

#. Status message when changing a local profile's name failed.
#: jellyfin_mpv_shim/mpvtk_browser/settings/servers.py
msgid "That user could not be renamed."
msgstr "அந்தப் பயனரின் பெயரை மாற்ற முடியவில்லை."

# seeded from jellyfin-web: LabelYear
#. Column heading in a library shown as a list: the item's release year.
#: jellyfin_mpv_shim/mpvtk_browser/tile_renderer.py
msgid "Year"
msgstr "ஆண்டு"

#. Column heading in a library shown as a list: how long the item runs.
#: jellyfin_mpv_shim/mpvtk_browser/tile_renderer.py
msgid "Length"
