#. setting. {0} is one of Bottom, Top, Middle.
#: jellyfin_mpv_shim/menu.py
#, python-brace-format
msgid "Subtitle Position: {0}"
msgstr "வசன நிலை: {0}"

#. Entry on the in-player Video Preferences menu, showing the current
