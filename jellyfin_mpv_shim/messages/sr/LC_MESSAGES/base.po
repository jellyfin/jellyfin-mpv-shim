msgstr "Копирање у међуспремник није доступно."

#: jellyfin_mpv_shim/mpvtk_browser/dialogs.py
msgid "Pasting from the clipboard is not available."
msgstr "Укљепавање из међуспремника није доступно."

#: jellyfin_mpv_shim/mpvtk_browser/dialogs.py
#, python-format
msgid ""
"Install the \"%(package)s\" package (for example \"apt install "
"%(package)s\"), or use MPV 0.41 or newer."
msgstr ""
