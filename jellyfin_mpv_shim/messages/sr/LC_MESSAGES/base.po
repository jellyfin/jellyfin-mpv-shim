#: jellyfin_mpv_shim/mpvtk_browser/dialogs.py
#: jellyfin_mpv_shim/mpvtk_browser/pages/music.py
msgid "Paginated"
msgstr "Страницирано"

#: jellyfin_mpv_shim/mpvtk_browser/dialogs.py
msgid ""
"Show one page of tiles at a time instead of scrolling. Applies to every "
"library on this device."
msgstr ""
"Прикажи по једну страницу плочица одједном уместо прескакања. Важи за сваку "
"библиотеку на овом уређају."

#: jellyfin_mpv_shim/mpvtk_browser/dialogs.py
msgid "View settings"
msgstr "Подешавања приказа"

#: jellyfin_mpv_shim/mpvtk_browser/dialogs.py
msgid ""
"Backs transparent logos with the light plate they were drawn for, and "
"shadows the ones whose own outline is white. Off puts the theme's card "
"colour behind them instead, with no shadows."
msgstr ""
"Подравњује прозирне логотипе светлом плочом за коју су нацртани и баца сенку "
"на оне чији је обрис бео. Off уместо тога поставља боју теме картице иза "
"њих, без сенки."

#: jellyfin_mpv_shim/mpvtk_browser/dialogs.py
