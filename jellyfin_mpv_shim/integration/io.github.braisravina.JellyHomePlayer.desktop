[Desktop Entry]
Name=JellyHome Player
Comment=MPV-based Jellyfin client for easy home streaming
Exec=jellyhome-player
Type=Application
Icon=io.github.braisravina.JellyHomePlayer
Categories=Video;AudioVideo;TV;Player
# Ties the mpv window back to this entry so the desktop uses the icon above
# instead of mpv's. Must match player.py's x11_name / wayland_app_id, which
# come from constants.DESKTOP_ID.
StartupWMClass=io.github.braisravina.JellyHomePlayer
